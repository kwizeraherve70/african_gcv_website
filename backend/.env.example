# Contact notifications run after the enquiry is committed; false disables
# automatic sending for isolated tests. Production defaults to enabled.
CONTACT_EMAIL_WORKER_ENABLED=true

# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# https://dashboard.stripe.com/test/webhooks (or `stripe listen --print-secret` locally)
STRIPE_WEBHOOK_SECRET=
# Frontend origin Stripe Checkout redirects back to after payment
# Canonical Vercel frontend origin (no trailing slash)
FRONTEND_URL=https://african-gcv-frontend.vercel.app
# Optional comma-separated preview/custom origins
FRONTEND_URLS=
